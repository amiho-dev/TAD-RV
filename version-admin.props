<Project>

  <!--
    April 2026 naming scheme:
    Version/FileVersion remain numeric for Windows metadata.
    InformationalVersion uses release channel naming.
  -->
  <PropertyGroup>
    <Version>26.4.7</Version>
    <FileVersion>26.4.7.1</FileVersion>
    <InformationalVersion>apr26-final.001-admin</InformationalVersion>
  </PropertyGroup>

</Project>
