<Project>

  <!--
    April 2026 naming scheme:
    Version/FileVersion remain numeric for Windows metadata.
    InformationalVersion uses release channel naming.
  -->
  <PropertyGroup>
    <Version>26.62.0</Version>
    <FileVersion>26.62.0</FileVersion>
    <InformationalVersion>v26.62.BF-admin</InformationalVersion>
  </PropertyGroup>

</Project>
