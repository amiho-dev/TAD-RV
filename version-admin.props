<Project>

  <!--
    April 2026 naming scheme:
    Version/FileVersion remain numeric for Windows metadata.
    InformationalVersion uses release channel naming.
  -->
  <PropertyGroup>
    <Version>26.4.8</Version>
    <FileVersion>26.4.8.500</FileVersion>
    <InformationalVersion>v26.04.08.500-admin</InformationalVersion>
  </PropertyGroup>

</Project>
